{
  "name": "aangan-call-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:migrate": "node --env-file=.env.local scripts/db.mjs migrate",
    "db:seed": "node --env-file=.env.local scripts/db.mjs seed",
    "db:test": "node --env-file=.env.local scripts/db.mjs test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "replay": "tsx --env-file=.env.local scripts/replay.ts",
    "test:integration": "INTEGRATION=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run tests/integration",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
