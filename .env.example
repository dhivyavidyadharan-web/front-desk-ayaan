# Copy to .env.local and fill in. Never commit real values.

# --- App ---
APP_BASE_URL=http://localhost:3000
# Sent by Vercel cron to /api/jobs/daily as "Authorization: Bearer ...".
CRON_SECRET=
# Required header value for /api/voice/mock/webhook (replays and tests).
MOCK_WEBHOOK_SECRET=

# --- Neon Postgres ---
# Pooled connection for the app. Dashboard queries switch to the RLS-enforced
# app_dashboard role per transaction; webhooks/jobs run as the owner.
DATABASE_URL=
# Direct (unpooled) connection for migrations.
DATABASE_URL_UNPOOLED=

# --- Dashboard sign-in (staff only; matched against the staff table by email) ---
AUTH_SECRET=

# --- Vaani (voice agent over WebRTC) ---
VAANI_API_KEY=
VAANI_AGENT_ID=b34fd448-d4bd-4bb7-b3ff-95e9c7f85065
# Appended to the webhook URL registered in Vaani: /api/voice/vaani/webhook?token=...
VAANI_WEBHOOK_SECRET=
VOICE_COST_PER_MINUTE_INR=

# --- Gemini (post-call extraction) ---
GEMINI_API_KEY=
# Use the current Gemini Flash model id; not hardcoded anywhere in code.
GEMINI_MODEL=
GEMINI_INPUT_COST_PER_MTOK_INR=
GEMINI_OUTPUT_COST_PER_MTOK_INR=

# --- cal.com (bookings are made by Vaani's cal.com integration; cal.com emails the designer) ---
# Webhook secret set in cal.com → Settings → Developer → Webhooks (URL: /api/calcom/webhook).
CALCOM_WEBHOOK_SECRET=

# --- Telegram (designer alerts) ---
TELEGRAM_BOT_TOKEN=
# Sent by Telegram with every update (setWebhook secret_token); also signs the designers' connect links.
TELEGRAM_WEBHOOK_SECRET=
