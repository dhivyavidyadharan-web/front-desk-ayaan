# Copy to .env.local and fill in. Never commit real values.

# --- App ---
APP_BASE_URL=http://localhost:3000
# Shared secret for /api/jobs/* (called by the scheduler).
JOBS_SECRET=

# --- Neon Postgres ---
# Pooled connection for the app. Dashboard queries switch to the RLS-enforced
# app_dashboard role per transaction; webhooks/jobs run as the owner.
DATABASE_URL=
# Direct (unpooled) connection for migrations.
DATABASE_URL_UNPOOLED=

# --- Dashboard sign-in (staff only; matched against the staff table by email) ---
AUTH_SECRET=

# --- Voice provider ---
# mock = replays fixtures/transcripts; vani = real provider (once access is available)
VOICE_PROVIDER=mock
VANI_API_KEY=
VANI_WEBHOOK_SECRET=
VANI_PHONE_NUMBER=
VOICE_COST_PER_MINUTE_INR=

# --- Gemini (post-call extraction) ---
GEMINI_API_KEY=
# Use the current Gemini Flash model id; not hardcoded anywhere in code.
GEMINI_MODEL=
GEMINI_INPUT_COST_PER_MTOK_INR=
GEMINI_OUTPUT_COST_PER_MTOK_INR=

# --- HubSpot (private app access token) ---
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID=

# --- cal.com (API v2) ---
# Per-designer event type ids live in the designers table.
CALCOM_API_KEY=
CALCOM_API_VERSION=2024-08-13

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Studio group that receives every call summary.
TELEGRAM_TEAM_CHAT_ID=
